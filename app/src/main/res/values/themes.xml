<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material3 DayNight — auto-switches light/dark with system setting.
        NoActionBar — custom header, no toolbar needed.
    -->
    <style name="Theme.YPI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_camera</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#1A3D26</item>
        <item name="colorOnPrimaryContainer">@color/color_camera</item>

        <!-- Transparent status bar so the overlay badges look native -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
