    <string name="usage_access_title">App labels need Usage Access</string>
    <string name="usage_access_desc">Grant Usage Access so YPI can show which app was active, and measure real per-app WiFi usage. Without it, entries show as "Unknown app." This is a local, on-device permission — no data ever leaves your phone.</string>
