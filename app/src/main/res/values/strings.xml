    <!-- AccessibilityService metadata (shown in Android Settings) -->
    <string name="accessibility_service_label">YPI Privacy Indicator</string>
    <string name="accessibility_service_description">
        Shows small colored icons at the top of the screen for camera, microphone,
        audio, network, Bluetooth, and location activity. No screen content is read
        or transmitted. Zero internet. 100% local.
    </string>

    <!-- Onboarding steps -->
    <string name="step1_title">Draw Over Other Apps</string>
    <string name="step1_desc">Needed for the indicator to float above all apps</string>
    <string name="step2_title">Enable Accessibility Service</string>
    <string name="step2_desc">Keeps the indicator visible in full-screen games and system UI</string>
    <string name="step3_title">Allow Usage Access</string>
    <string name="step3_desc">Optional — labels which app was active, and measures real per-app WiFi usage</string>
    <string name="step4_title">Allow Bluetooth Access</string>
    <string name="step4_desc">Needed to detect when a Bluetooth device connects (Android 12+)</string>
    <string name="step5_title">Allow Location Access</string>
    <string name="step5_desc">Needed to detect active GPS use. Only watches the GPS radio — never reads your actual coordinates</string>

